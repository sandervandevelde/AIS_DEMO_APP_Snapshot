EVALUATE
TOPN(
    50,
    SUMMARIZECOLUMNS(
        'Kusto Query Result'[cameraId],
        "receivedAtUtc", CALCULATE(MAX('Kusto Query Result'[receivedAtUtc]), NOT ISBLANK('Kusto Query Result'[ChunkBase64])),
        "imagePayloadLength", CALCULATE(MAX('Kusto Query Result'[imagePayloadLength]), NOT ISBLANK('Kusto Query Result'[ChunkBase64]))
    ),
    [receivedAtUtc], DESC
)
