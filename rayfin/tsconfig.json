{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": false,
    "rootDir": "./",
    "outDir": "./.temp/compiled",
    "tsBuildInfoFile": "./.temp/tsconfig.tsbuildinfo"
  },
  "include": [
    "data/**/*.ts"
  ]
}
